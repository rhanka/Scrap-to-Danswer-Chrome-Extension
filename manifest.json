{
    "manifest_version": 3,
    "name": "Scrap & Chat with OpenAI",
    "version": "0.1",
    "description": "Scrap web sites, push them to OpenAI RAG and chat using deep-chat.",
    "permissions": ["activeTab","scripting", "downloads", "storage", "tabs"],
    "host_permissions": [
        "https://*/*",
        "http://*/*"
     ],
    "background": {
      "service_worker": "background.js",
      "type": "module"
    },
    "action": {
      "default_popup": "popup.html",
      "default_title": "Scrap now"
    },
    "web_accessible_resources": [
      {
        "resources": ["jszip.min.js"],
        "matches": ["<all_urls>"]
      }
    ]
  }